  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Half-Life Black Mesa - Українською [Текст + Звук + Субтитри]",
        "meta_descr": "Завантажити україніфікатор для Steam версії Black Mesa [Half-Life remake] від спілки \"Тлумачі SkyNet\". Повна сумісність з Steam версією, а також з Steam Deck.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": ""
